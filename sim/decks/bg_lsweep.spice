foreach tmp -40 27 125
 foreach vd 1.08 1.2 1.32
  set temp = $tmp
  alter VDD = $vd
  op
  let p_lb = 2
  let p_wp = 1.8
  let p_temp = $tmp
  let p_vdd = $vd
  let i_up_na = 1e9*i(Vout1)
  let i_dn_na = -1e9*i(Vout2)
  print p_lb p_wp p_temp p_vdd i_up_na i_dn_na
  echo "ROWEND"
 end
end

alterparam Lb = 2
alterparam Ls = 2
alterparam Wp = 2.0
reset
foreach tmp -40 27 125
 foreach vd 1.08 1.2 1.32
  set temp = $tmp
  alter VDD = $vd
  op
  let p_lb = 2
  let p_wp = 2.0
  let p_temp = $tmp
  let p_vdd = $vd
  let i_up_na = 1e9*i(Vout1)
  let i_dn_na = -1e9*i(Vout2)
  print p_lb p_wp p_temp p_vdd i_up_na i_dn_na
  echo "ROWEND"
 end
end

alterparam Lb = 4
alterparam Ls = 4
alterparam Wp = 1.8
reset
foreach tmp -40 27 125
 foreach vd 1.08 1.2 1.32
  set temp = $tmp
  alter VDD = $vd
  op
  let p_lb = 4
  let p_wp = 1.8
  let p_temp = $tmp
  let p_vdd = $vd
  let i_up_na = 1e9*i(Vout1)
  let i_dn_na = -1e9*i(Vout2)
  print p_lb p_wp p_temp p_vdd i_up_na i_dn_na
